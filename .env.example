# Environment Variable / Cloudflare Secrets overrides for CI/CD (Cloudflare Pages)
# Leave blank locally to use defaults in site.config.json (never commit .env to GitHub)
SITE_URL=https://domainname.web.id
CONTACT_EMAIL=admin@domainname.web.id
GA_MEASUREMENT_ID=
GSC_VERIFICATION=
ADSENSE_CLIENT_ID=
ADSENSE_DIRECT_SELLER_ID=f08c47fec0942fa0
ADSENSE_ENABLE_AUTO_ADS=false
BING_VERIFICATION=
YANDEX_VERIFICATION=
AHREFS_SITE_VERIFICATION=

# Cloudflare Pages Build Setting (set in Cloudflare Dashboard -> Environment variables)
# NODE_VERSION=20

# Server-only secrets (NEVER place private API keys in site.config.json or HTML files)
# PORT=3000
